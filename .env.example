# Research OS Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://research_os:your_db_password@localhost:5432/research_os
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://:your_redis_password@localhost:6379/0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# ============================================
# File Storage Configuration
# ============================================
# Local file storage on /data disk
STORAGE_BACKEND=local
RESEARCH_OS_WORKSPACE_ROOT=/data/research-os/experiments
STORAGE_BASE_PATH=/data/research-os/files
PDF_STORAGE_PATH=/data/research-os/pdfs
CACHE_PATH=/data/research-os/cache
LOG_PATH=/data/research-os/logs

# ============================================
# LLM Configuration
# ============================================
# DeepSeek values are bootstrap-only; saved runtime credentials live in the encrypted credential store.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
CREDENTIAL_ENCRYPTION_KEY=

# ============================================
# Tongyi/DashScope Embedding & Rerank
# ============================================
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSION=1024
DASHSCOPE_MULTIMODAL_MODEL=qwen3-vl-embedding
DASHSCOPE_RERANK_MODEL=gte-rerank-v2

# ============================================
# Academic Data Sources
# ============================================
SEMANTIC_SCHOLAR_API_KEY=your-s2-api-key-here
OPENALEX_API_KEY=
OPENALEX_API_KEYS=
OPENALEX_EMAIL=your-email@example.com
UNPAYWALL_EMAIL=your-email@example.com

# ============================================
# GROBID Configuration
# ============================================
GROBID_URL=http://localhost:8070

# ============================================
# API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
WORKER_CONCURRENCY=2
DEBUG=false

# ============================================
# Observability
# ============================================
LOG_LEVEL=INFO
ENABLE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ============================================
# Research Run Defaults
# ============================================
DEFAULT_MAX_RUNTIME_MINUTES=90
DEFAULT_MAX_PAPERS=150
DEFAULT_MAX_FULLTEXT_READS=40
DEFAULT_MAX_COST_USD=30.0
