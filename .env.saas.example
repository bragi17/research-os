AUTH_REQUIRED=true
JWT_SECRET=change-me-generate-a-long-random-secret
JWT_EXPIRATION_HOURS=24
CREDENTIAL_ENCRYPTION_KEY=change-me-generate-a-long-random-secret

DATABASE_URL=postgresql://ros_user:ros_pass@postgres:5432/research_os
REDIS_URL=redis://redis:6379/0

STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=research-os
MINIO_USE_SSL=false

GROBID_URL=http://grobid:8070
RESEARCH_OS_WORKSPACE_ROOT=/data/research-os/workspaces

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSION=1024
DASHSCOPE_MULTIMODAL_MODEL=qwen3-vl-embedding
DASHSCOPE_RERANK_MODEL=gte-rerank-v2

SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=
UNPAYWALL_EMAIL=
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
